# ---- Côté serveur (Vercel → Settings → Environment Variables) ----
# Clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : modèle Gemini utilisé (par défaut gemini-3.8-flash)
GEMINI_MODEL=

# ---- Supabase (Project Settings → API) ----
# Ces deux variables servent au navigateur ET à la vérification des sessions côté serveur.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
